<?xml version="1.0"?>
<robot name="two_claw_robot">

    <!-- Base of the robot -->
    <link name="base_link">

    </link>

    <!-- Hexagonal Prism -->
    <link name="hex_link">
        <visual>
            <geometry>
                <mesh filename="meshes/prism_0l03_0h07.obj" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="meshes/prism_0l03_0h07.obj" scale="1 1 1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.00008" iyy="0.00008" izz="0.00008" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="hex_joint" type="revolute">
        <parent link="base_link"/>
        <child link="hex_link"/>
        <!-- <origin xyz="0.05 0 0" rpy="-1.570796 0 0"/> -->
        <origin xyz="0.07 0 0" rpy="-1.570796 0 0"/>
        <axis xyz="0 0 -1"/>
        <!-- <limit lower="-3.14159" upper="3.14159"/> -->
    </joint>

    <!-- Claw 1 -->
    <link name="claw1_base"/>
    
    <joint name="claw1_joint" type="fixed">
        <parent link="base_link"/>
        <child link="claw1_base"/>
        <origin xyz="0 0.03 0.015" rpy="0 0.523598 0"/>
    </joint>

    <link name="claw1_mid">
        <visual>
            <geometry>
                <cylinder radius="0.01" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <inertia ixx="0.00001" iyy="0.00002" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="claw1_mid_joint" type="revolute">
        <parent link="claw1_base"/>
        <child link="claw1_mid"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="1.5708"/>
    </joint>

    <link name="claw1_end">
        <visual>
            <geometry>
                <cylinder radius="0.01" length="0.045"/>
            </geometry>
            <origin xyz="0 0 0.0225" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.045"/>
            </geometry>
            <origin xyz="0 0 0.0225" rpy="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0.0225" rpy="0 0 0"/>
            <inertia ixx="0.00001" iyy="0.00002" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="claw1_end_joint" type="revolute">
        <parent link="claw1_mid"/>
        <child link="claw1_end"/>
        <origin xyz="0 0 0.05"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="1.5708"/>
    </joint>

    <!-- Claw 2 (Mirrored) -->
    <link name="claw2_base"/>
    
    <joint name="claw2_joint" type="fixed">
        <parent link="base_link"/>
        <child link="claw2_base"/>
        <origin xyz="0 0.03 -0.015" rpy="0 2.617994 0"/>
    </joint>

    <link name="claw2_mid">
        <visual>
            <geometry>
                <cylinder radius="0.01" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <inertia ixx="0.00001" iyy="0.00002" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="claw2_mid_joint" type="revolute">
        <parent link="claw2_base"/>
        <child link="claw2_mid"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="0" upper="1.5708"/>
    </joint>

    <link name="claw2_end">
        <visual>
            <geometry>
                <cylinder radius="0.01" length="0.045"/>
            </geometry>
            <origin xyz="0 0 0.0225" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.045"/>
            </geometry>
            <origin xyz="0 0 0.0225" rpy="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <origin xyz="0 0 0.0225" rpy="0 0 0"/>
            <inertia ixx="0.00001" iyy="0.00002" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="claw2_end_joint" type="revolute">
        <parent link="claw2_mid"/>
        <child link="claw2_end"/>
        <origin xyz="0 0 0.05"/>
        <axis xyz="0 -1 0"/>
        <limit lower="0" upper="1.5708"/>
    </joint>

</robot>
